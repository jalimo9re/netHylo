# Runtime
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nethylo
DB_PASSWORD=nethylo_secret
DB_NAME=nethylo
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=24h

# CORS
CORS_ORIGIN=http://localhost:4200

# Superadmin (seed)
SUPERADMIN_EMAIL=admin@nethylo.com
SUPERADMIN_PASSWORD=Admin123!

# Billing (mock Stripe)
BILLING_MOCK=true
BILLING_WEBHOOK_SECRET=billing_webhook_dev_secret

MOBILE_PUSH_MOCK=true
MOBILE_DEVICE_SIGNATURE_SECRET=

# Voice / Telnyx
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_WEBHOOK_SECRET=

# Social planner
SOCIAL_MOCK=true

# Build metadata (optional)
APP_VERSION=0.1.0
APP_COMMIT_SHA=dev-local
